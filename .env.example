# Frontend public configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend configuration
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=
# Optional, server-side only. Do not expose this value to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=local

# Optional future local PostgreSQL configuration
POSTGRES_DB=discipline_app
POSTGRES_USER=discipline_app
POSTGRES_PASSWORD=

# Future AWS deployment configuration
AWS_REGION=
AWS_S3_FRONTEND_BUCKET=
AWS_CLOUDFRONT_DISTRIBUTION_ID=
AWS_S3_FILES_BUCKET=
